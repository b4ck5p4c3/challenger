generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id           String        @id @default(uuid())
  brand        String
  name         String
  volume       Decimal       @db.Decimal(10, 4)
  caffeine     Decimal       @db.Decimal(10, 4)
  alcohol      Decimal       @db.Decimal(10, 4)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  productCodes ProductCode[]

  @@map("products")
}

model ProductCode {
  id          String     @id @default(uuid())
  gtin        String     @unique
  productId   String?    @map("product_id")
  product     Product?   @relation(fields: [productId], references: [id])
  crptData    Json?      @map("crpt_data") @db.JsonB
  edadealData Json?      @map("edadeal_data") @db.JsonB
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  scanUnits   ScanUnit[]

  @@index([productId])
  @@map("product_codes")
}

model ScanUnit {
  id              String      @id @default(uuid())
  productCodeId   String      @map("product_code_id")
  productCode     ProductCode @relation(fields: [productCodeId], references: [id])
  chestnyZnakCode String?     @unique @map("chestny_znak_code")
  chestnyZnakData Json?       @map("chestny_znak_data") @db.JsonB
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  @@index([productCodeId, createdAt])
  @@map("scan_units")
}

model ShuttleTemplate {
  id        String   @id @default(uuid())
  name      String
  situation String
  enabled   Boolean  @default(true)
  template  String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([situation, enabled])
  @@map("shuttle_templates")
}
