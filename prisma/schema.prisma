generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Product {
  @@map("products")

  id            String        @id @default(uuid())
  brand         String
  name          String
  volume        Decimal       @db.Decimal(10, 4)
  caffeine      Decimal       @db.Decimal(10, 4)
  alcohol       Decimal       @db.Decimal(10, 4)
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  productCodes  ProductCode[] @map("product_codes")
}

model ProductCode {
  @@map("product_codes")

  id          String      @id @default(uuid())
  gtin        String      @unique
  productId   String?     @map("product_id")
  product     Product?    @relation(fields: [productId], references: [id])
  crptData    Json?       @db.JsonB @map("crpt_data")
  edadealData Json?       @db.JsonB @map("edadeal_data")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  scanUnits   ScanUnit[]  @map("scan_units")

  @@index([productId])
}

model ScanUnit {
  @@map("scan_units")

  id              String      @id @default(uuid())
  productCodeId   String      @map("product_code_id")
  productCode     ProductCode @relation(fields: [productCodeId], references: [id]) @map("product_code")
  chestnyZnakCode String?     @unique @map("chestny_znak_code")
  chestnyZnakData Json?       @db.JsonB @map("chestny_znak_data")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  @@index([productCodeId, createdAt])
}
